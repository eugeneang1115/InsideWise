# Server
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/insidewise
PORT=8787
# Comma-separated moderator account emails (explicit allowlist).
MODERATOR_EMAILS=
# Origins allowed to call the API with credentials. https://localhost is the Android app.
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
SECURE_COOKIES=false
# Serve the built web app from this folder (set in the Docker image).
WEB_DIST=

# Web / Android build (Vite)
# Public API origin for the Android app. Leave empty for the web build (same origin).
VITE_API_URL=
# Map tiles. OpenStreetMap's public tiles are for light use only; set a provider for production.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
